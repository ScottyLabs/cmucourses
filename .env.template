# Copy to .env in the repo root and fill in.

# --- Frontend ---
# Live backend. No trailing slash. Use http://localhost:3000 to run the backend locally.
NEXT_PUBLIC_BACKEND_URL="https://course.apis.scottylabs.org"
# Backend serving /user/profile. Falls back to NEXT_PUBLIC_BACKEND_URL when unset. The public
# backend has no profile routes, so point this at a local backend (http://localhost:3000).
NEXT_PUBLIC_PROFILE_BACKEND_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional analytics; the app runs without these.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Backend (only needed if you run apps/backend locally) ---
# Read by packages/db/schema.prisma. For profiles, an empty MongoDB Atlas cluster works (Prisma
# needs a replica set, so a standalone local mongod won't); course routes will return nothing.
# Atlas → Network Access: allow this IP, or 0.0.0.0/0 for a dev cluster, or Profile will hang
# then 500 with "Server selection timeout" when you change networks.
MONGODB_URI=
PORT=3000
AUTH_ENABLED=false
# Public key (PEM) of the Clerk instance the frontend signs in with. /user/profile always
# verifies tokens with it, even when AUTH_ENABLED=false.
CLERK_PEM_KEY=
CLERK_LOGIN_HOST=
BACKEND_ENV=development
# Production defaults to requiring an @cmu.edu or @andrew.cmu.edu Clerk account. Set false only
# for a deliberately public deployment.
REQUIRE_CMU_EMAIL=true
